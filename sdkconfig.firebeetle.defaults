# DFRobot FireBeetle 2 ESP32-E (DFR0654) qualification profile.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_AMULET_LED_GPIO=5
CONFIG_AMULET_LED_POWER_GPIO=-1
CONFIG_AMULET_BUZZER_GPIO=25
CONFIG_AMULET_BUTTON_GPIO=27
CONFIG_AMULET_BUTTON_INTERNAL_PULLUP=y
CONFIG_AMULET_EXTERNAL_BUTTON_GPIO=26
CONFIG_AMULET_EXTERNAL_BUTTON_INTERNAL_PULLUP=y
